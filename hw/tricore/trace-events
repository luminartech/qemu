# tc4x.c
tc4x_dma_start(uint32_t ch, bool hw, uint32_t sadr, uint32_t dadr, uint32_t chcfgr) "ch %u hw %d sadr 0x%08x dadr 0x%08x chcfgr 0x%08x"

# tc4x_sfr_store.c
tc4x_sfr_store_cold_image(unsigned pages) "%u pages"
tc4x_sfr_store_reset(void) ""

# tc4x_ir.c
tc4x_ir_ack(uint32_t core, uint32_t prio, uint32_t src) "core %u prio %u src 0x%08x"

# tc4x_timebase.c
tc4x_timebase_set_scale(uint32_t scale, int64_t guest_ns) "scale %u guest %" PRId64 " ns"
tc4x_timebase_barrier(int64_t barrier, bool held, bool stood) "barrier %" PRId64 " held %d stood %d"

# tc4x_i2c.c
tc4x_i2c_transfer(unsigned bus, unsigned addr, bool read, unsigned len, bool ack) "bus %u addr 0x%02x read %d len %u ack %d"

# tc4x_qspi.c
tc4x_qspi_frame(unsigned n, unsigned cs, uint32_t bacon) "qspi%u cs %u bacon 0x%08x"
tc4x_qspi_frame_end(unsigned n, int cs, bool pt) "qspi%u cs %d pt %d"
tc4x_qspi_dma_job(unsigned n, bool ran) "qspi%u ran %d"

# tc4x_ports.c
tc4x_ports_out(unsigned n, uint32_t old, uint32_t out) "p%02u 0x%04x -> 0x%04x"

# tc4x_kit.c
tc4x_kit_led(unsigned led, bool on) "led %u on %d"
